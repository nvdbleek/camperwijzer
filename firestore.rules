rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Iedereen met een geverifieerd Google-account op @bleeken.eu mag lezen en schrijven.
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@bleeken[.]eu$');
    }
    match /trips/{tripId} {
      allow read, write: if allowed();
      match /checks/{checkId} {
        allow read, write: if allowed();
      }
    }
    // Al het andere is dicht.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
